# نسخي هذا الملف إلى .env.local واملئي القيم الحقيقية (.env.local نفسه
# بـ.gitignore، لا يُرفع أبداً).

# Supabase — نفس مشروع سُكّر الرئيسي (لا قاعدة بيانات منفصلة للمندوب)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# رقم واتساب الدعم الظاهر بصفحات /privacy و/account-deletion وغيرها
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# D7 Networks — إرسال SMS لأكواد OTP الخاصة بتسجيل/دخول المندوب
# (src/lib/sms/d7Provider.ts). بدون D7_API_TOKEN، getSmsProvider() يستخدم
# DevConsoleSmsProvider تلقائياً (يطبع الكود بسجل السيرفر بدل إرسال SMS
# حقيقي — مناسب للتطوير المحلي فقط).
# D7_API_TOKEN: Bearer token من لوحة D7 (Personal Access Token)
# D7_SENDER_ID: هوية المرسل المعتمدة من D7 لليمن — افتراضي "SUKKAR" إن تُرك فارغاً
D7_API_TOKEN=
D7_SENDER_ID=
